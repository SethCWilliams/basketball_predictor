# NBA Stats Tracker - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite (Default for development)
DATABASE_URL=sqlite:///./nba_predictions.db

# PostgreSQL (Optional - for production or if you prefer)
# DATABASE_URL=postgresql://user:password@localhost:5432/nba_predictions

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API Port (default: 8000)
# BACKEND_PORT=8000

# Frontend Port (default: 5173)
# FRONTEND_PORT=5173

# API URL for frontend (used by Vite)
VITE_API_URL=http://localhost:8000

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Python environment
PYTHONUNBUFFERED=1

# Debug mode (set to 0 in production)
# DEBUG=1

# =============================================================================
# SCRAPING CONFIGURATION
# =============================================================================

# Default timezone for game times (IANA format)
# DEFAULT_TIMEZONE=America/New_York

# Rate limiting for Basketball Reference scraper
# SCRAPER_DELAY_SECONDS=1

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# These are set automatically in docker-compose.yml
# Only override if you need custom values

# Container names
# BACKEND_CONTAINER_NAME=nba_tracker_backend
# FRONTEND_CONTAINER_NAME=nba_tracker_frontend

# Network name
# DOCKER_NETWORK=nba_network

# =============================================================================
# NOTES
# =============================================================================

# 1. This file should NOT be committed to version control
# 2. Copy this to .env: cp .env.example .env
# 3. Update values as needed for your environment
# 4. Docker Compose will automatically load .env file
# 5. Python 3.12 is required (not 3.13 - pydantic compatibility)
